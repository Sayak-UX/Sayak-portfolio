{
    "name": "sayak25",
    "rewrites": [
        { "source": "/((?!assets/|api/).*)", "destination": "/" }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}